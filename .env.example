# Production configuration for megachat.live.
# Copy to .env.production.local for a self-hosted production server, or set
# these values in your hosting provider's environment settings.
NEXT_PUBLIC_DEMO_MODE=false
# Required: MongoDB Atlas or a replica set (transactions are required).
MONGODB_URI=
MONGODB_DB=mega_games
# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
MEGACHAT_PRIVATE_KEY=
# Required: a unique password of at least 16 characters.
ADMIN_PASSWORD=Mega_Admin_Password_123
APP_ORIGIN=https://megachat.live
# Live betting stays disabled until launch authentication and reconciliation are integrated.
LIVE_BETTING_ENABLED=false
MEGA_LAUNCH_VERIFIER_SECRET=